ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AEXML" "${PODS_CONFIGURATION_BUILD_DIR}/ESOpenSourceLicensesKit" "${PODS_CONFIGURATION_BUILD_DIR}/FeedKit" "${PODS_CONFIGURATION_BUILD_DIR}/GoogleUtilities" "${PODS_CONFIGURATION_BUILD_DIR}/HTMLString" "${PODS_CONFIGURATION_BUILD_DIR}/Kingfisher" "${PODS_CONFIGURATION_BUILD_DIR}/Kml.swift" "${PODS_CONFIGURATION_BUILD_DIR}/PromisesObjC" "${PODS_CONFIGURATION_BUILD_DIR}/STRegex" "${PODS_ROOT}/GoogleAnalytics/Frameworks" "${PODS_XCFRAMEWORKS_BUILD_DIR}/GoogleAnalytics"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AEXML/AEXML.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ESOpenSourceLicensesKit/ESOpenSourceLicensesKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/FeedKit/FeedKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/GoogleUtilities/GoogleUtilities.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/HTMLString/HTMLString.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Kingfisher/Kingfisher.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/Kml.swift/Kml_swift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/PromisesObjC/FBLPromises.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/STRegex/Regex.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_CFLAGS = $(inherited) -isystem "${PODS_CONFIGURATION_BUILD_DIR}/AEXML/AEXML.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/ESOpenSourceLicensesKit/ESOpenSourceLicensesKit.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/FeedKit/FeedKit.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/GoogleUtilities/GoogleUtilities.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/HTMLString/HTMLString.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/Kingfisher/Kingfisher.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/Kml.swift/Kml_swift.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/PromisesObjC/FBLPromises.framework/Headers" -isystem "${PODS_CONFIGURATION_BUILD_DIR}/STRegex/Regex.framework/Headers" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/AEXML" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/ESOpenSourceLicensesKit" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/FeedKit" -iframework "${PODS_ROOT}/GoogleAnalytics/Frameworks" -iframework "${PODS_XCFRAMEWORKS_BUILD_DIR}/GoogleAnalytics" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/GoogleUtilities" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/HTMLString" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/Kingfisher" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/Kml.swift" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/PromisesObjC" -iframework "${PODS_CONFIGURATION_BUILD_DIR}/STRegex"
OTHER_LDFLAGS = $(inherited) -ObjC -l"sqlite3" -l"z" -framework "AEXML" -framework "Accelerate" -framework "CFNetwork" -framework "CoreData" -framework "ESOpenSourceLicensesKit" -framework "FBLPromises" -framework "FeedKit" -framework "Foundation" -framework "GoogleAnalytics" -framework "GoogleUtilities" -framework "HTMLString" -framework "Kingfisher" -framework "Kml_swift" -framework "Regex" -framework "Security" -framework "SystemConfiguration" -framework "UIKit" -weak_framework "Combine" -weak_framework "SwiftUI"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
